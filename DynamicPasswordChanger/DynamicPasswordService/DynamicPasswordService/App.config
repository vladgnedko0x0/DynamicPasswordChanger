<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <appSettings>
    <!--
      FIX: Username is now configurable instead of hardcoded to "test".
      Set this to the Windows account whose password should be changed on startup.
    -->
    <add key="TargetUsername" value="YourWindowsUsername" />
  </appSettings>
</configuration>
